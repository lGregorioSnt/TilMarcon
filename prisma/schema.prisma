generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  nome      String
  email     String    @unique
  senha     String
  pin       String?
  role      String    @default("OPERADOR")
  setor     String?
  pedidos   Pedido[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Item {
  id          Int          @id @default(autoincrement())
  codigo      String       @unique
  nome        String
  unidade     String       @default("UN")
  quantidade  Int          @default(0)
  localizacao String?
  pedidoItens PedidoItem[]
  estornos    Estorno[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Pedido {
  id            Int          @id @default(autoincrement())
  userId        Int
  setor         String?
  status        String       @default("AGUARDANDO_SEPARACAO")
  pinValidadoEm DateTime?
  entregueEm    DateTime?
  observacao    String?      @db.Text
  user          User         @relation(fields: [userId], references: [id])
  itens         PedidoItem[]
  estornos      Estorno[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model PedidoItem {
  id                Int      @id @default(autoincrement())
  pedidoId          Int
  itemId            Int
  quantidade        Int
  quantidadeEnviada Int?
  separado          Boolean  @default(false)
  pedido            Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  item              Item     @relation(fields: [itemId], references: [id])
}

model Estorno {
  id                  Int      @id @default(autoincrement())
  pedidoId            Int
  itemId              Int
  quantidadeEstornada Int
  motivo              String
  realizadoPorUserId  Int
  createdAt           DateTime @default(now())
  pedido              Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  item                Item     @relation(fields: [itemId], references: [id])
}
